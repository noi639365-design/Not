local WarpTab = Window:Tab({
    Title = "วาป",
    Icon = "map-pin",
})

WarpTab:Section({
    Title = "Teleport"
})

local SelectedWarpPlayer = nil
local WarpDropdown = nil

local function GetWarpPlayers()
    local List = {}

    for _, TargetPlayer in ipairs(Players:GetPlayers()) do
        if TargetPlayer ~= Player then
            table.insert(List, TargetPlayer.Name)
        end
    end

    table.sort(List)

    return List
end

local function GetWarpTarget()
    if not SelectedWarpPlayer or SelectedWarpPlayer == "" or SelectedWarpPlayer == "ไม่มีผู้เล่น" then
        return nil
    end

    return Players:FindFirstChild(SelectedWarpPlayer)
end

local InitialWarpPlayers = GetWarpPlayers()
local InitialWarpValue = InitialWarpPlayers[1] or "ไม่มีผู้เล่น"

if InitialWarpPlayers[1] then
    SelectedWarpPlayer = InitialWarpPlayers[1]
end

WarpDropdown = WarpTab:Dropdown({
    Title = "รายชื่อผู้เล่น",
    Desc = "เลือกผู้เล่นที่จะวาปไปหา",
    Values = #InitialWarpPlayers > 0 and InitialWarpPlayers or {"ไม่มีผู้เล่น"},
    Value = InitialWarpValue,
    AllowNone = true,
    SearchBarEnabled = true,
    Callback = function(Value)
        if type(Value) == "table" then
            Value = Value[1]
        end

        if not Value or Value == "" or Value == "ไม่มีผู้เล่น" then
            SelectedWarpPlayer = nil
            return
        end

        SelectedWarpPlayer = Value
    end
})

local function RefreshWarpList()
    if not WarpDropdown then
        return
    end

    local List = GetWarpPlayers()

    if #List > 0 then
        WarpDropdown:Refresh(List)
        WarpDropdown:Select(List[1])
        SelectedWarpPlayer = List[1]
    else
        SelectedWarpPlayer = nil
        WarpDropdown:Refresh({"ไม่มีผู้เล่น"})
        WarpDropdown:Select("ไม่มีผู้เล่น")
    end
end

