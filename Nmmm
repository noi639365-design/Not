-- =========================================================
-- CHARACTER HELPERS
-- =========================================================

local function GetCharacter()
    return Player.Character
end

local function GetHumanoid(Character)
    if not Character then
        return nil
    end

    return Character:FindFirstChildOfClass("Humanoid")
end

local function GetRoot(Character)
    if not Character then
        return nil
    end

    return Character:FindFirstChild("HumanoidRootPart")
end

-- =========================================================
-- SPEED
-- =========================================================

local function SaveSpeed(Humanoid)
    if OriginalWalkSpeed == nil then
        OriginalWalkSpeed = Humanoid.WalkSpeed
    end
end

local function ApplySpeed()
    local Character = GetCharacter()
    local Humanoid = GetHumanoid(Character)

    if not Humanoid then
        return
    end

    if SpeedEnabled then
        SaveSpeed(Humanoid)
        Humanoid.WalkSpeed = SpeedValue
    else
        if OriginalWalkSpeed ~= nil then
            Humanoid.WalkSpeed = OriginalWalkSpeed
        else
            Humanoid.WalkSpeed = 16
        end

        OriginalWalkSpeed = nil
    end
end

-- =========================================================
-- JUMP
-- =========================================================

local function SaveJump(Humanoid)
    if OriginalJumpPower == nil then
        OriginalJumpPower = Humanoid.JumpPower
    end

    if OriginalJumpHeight == nil then
        OriginalJumpHeight = Humanoid.JumpHeight
    end
end

local function ApplyJump()
    local Character = GetCharacter()
    local Humanoid = GetHumanoid(Character)

    if not Humanoid then
        return
    end

    if JumpEnabled then
        SaveJump(Humanoid)

        if Humanoid.UseJumpPower then
            Humanoid.JumpPower = JumpValue
        else
            Humanoid.JumpHeight = JumpValue / 3
        end
    else
        if Humanoid.UseJumpPower then
            if OriginalJumpPower ~= nil then
                Humanoid.JumpPower = OriginalJumpPower
            else
                Humanoid.JumpPower = 50
            end
        else
            if OriginalJumpHeight ~= nil then
                Humanoid.JumpHeight = OriginalJumpHeight
            else
                Humanoid.JumpHeight = 7.2
            end
        end

        OriginalJumpPower = nil
        OriginalJumpHeight = nil
    end
end

-- =========================================================
-- INFINITE JUMP
-- =========================================================

UserInputService.JumpRequest:Connect(function()
    if not InfiniteJumpEnabled then
        return
    end

    local Character = GetCharacter()
    local Humanoid = GetHumanoid(Character)

    if Humanoid then
        Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

local function ApplyInfiniteJump(Character)
    local Humanoid = GetHumanoid(Character)

    if not Humanoid then
        return
    end

    if InfiniteJumpEnabled then
        if OriginalBreakJointsOnDeath == nil then
            OriginalBreakJointsOnDeath = Humanoid.BreakJointsOnDeath
        end

        Humanoid.BreakJointsOnDeath = false
    else
        if OriginalBreakJointsOnDeath ~= nil then
            Humanoid.BreakJointsOnDeath = OriginalBreakJointsOnDeath
        end

        OriginalBreakJointsOnDeath = nil
    end
end

-- =========================================================
-- TARGET VISIBILITY
-- =========================================================

local function IsVisible(TargetPart)
    if not Camera then
        return false
    end

    local Character = GetCharacter()

    if not Character then
        return false
    end

    local Head = Character:FindFirstChild("Head")

    if not Head then
        return false
    end

    local Params = RaycastParams.new()

    Params.FilterType = Enum.RaycastFilterType.Exclude

    Params.FilterDescendantsInstances = {
        Character,
        Camera
    }

    Params.IgnoreWater = true

    local Direction = TargetPart.Position - Head.Position

    local Result = workspace:Raycast(
        Head.Position,
        Direction,
        Params
    )

    if not Result then
        return true
    end

    return Result.Instance:IsDescendantOf(TargetPart.Parent)
end

-- =========================================================
-- CLOSEST TARGET
-- =========================================================

local function GetClosestHeadInFOV()
    if not Camera then
        return nil
    end

    local Closest = nil
    local Shortest = math.huge

    local ScreenCenter = Vector2.new(
        Camera.ViewportSize.X / 2,
        Camera.ViewportSize.Y / 2
    )

    for _, TargetPlayer in ipairs(Players:GetPlayers()) do
        if TargetPlayer ~= Player and TargetPlayer.Character then
            local Character = TargetPlayer.Character
            local Humanoid = GetHumanoid(Character)
            local Head = Character:FindFirstChild("Head")

            if Humanoid and Head and Humanoid.Health > 0 then
                local ScreenPos, OnScreen = Camera:WorldToViewportPoint(Head.Position)

                if OnScreen and ScreenPos.Z > 0 then
                    local Center = Vector2.new(ScreenPos.X, ScreenPos.Y)
                    local Distance = (Center - ScreenCenter).Magnitude

                    if Distance <= FovRadius and Distance < Shortest and IsVisible(Head) then
                        Shortest = Distance
                        Closest = Head
                    end
                end
            end
        end
    end

    return Closest
end

-- =========================================================
-- ESP
-- =========================================================

local ESPName = "XDHub_WhiteESP"

local function RemoveESP(Character)
    if not Character then
        return
    end

    local Old = Character:FindFirstChild(ESPName)

    if Old then
        Old:Destroy()
    end
end

local function ApplyESP(Character)
    if not ESPEnabled then
        return
    end

    if not Character or not Character.Parent then
        return
    end

    RemoveESP(Character)

    local Highlight = Instance.new("Highlight")

    Highlight.Name = ESPName
    Highlight.Adornee = Character

    Highlight.FillColor = Color3.fromRGB(255, 255, 255)
    Highlight.OutlineColor = Color3.fromRGB(255, 255, 255)

    Highlight.FillTransparency = 0.5
    Highlight.OutlineTransparency = 0

    Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

    Highlight.Parent = Character
end

local function ToggleAllESP(State)
    ESPEnabled = State

    for _, TargetPlayer in ipairs(Players:GetPlayers()) do
        if TargetPlayer ~= Player and TargetPlayer.Character then
            if State then
                ApplyESP(TargetPlayer.Character)
            else
                RemoveESP(TargetPlayer.Character)
            end
        end
    end
end

local function SetupESPPlayer(TargetPlayer)
    if TargetPlayer == Player then
        return
    end

    TargetPlayer.CharacterAdded:Connect(function(Character)
        task.wait(0.5)

        if ESPEnabled then
            ApplyESP(Character)
        end
    end)

    if TargetPlayer.Character and ESPEnabled then
        ApplyESP(TargetPlayer.Character)
    end
end

for _, TargetPlayer in ipairs(Players:GetPlayers()) do
    SetupESPPlayer(TargetPlayer)
end

Players.PlayerAdded:Connect(SetupESPPlayer)

-- =========================================================
-- NOCLIP
-- =========================================================

local function SaveNoclipParts()
    NoclipParts = {}

    local Character = GetCharacter()

    if not Character then
        return
    end

    for _, Object in ipairs(Character:GetDescendants()) do
        if Object:IsA("BasePart") then
            NoclipParts[Object] = Object.CanCollide
        end
    end
end

local function RestoreNoclip()
    for Part, OriginalValue in pairs(NoclipParts) do
        if Part and Part.Parent then
            Part.CanCollide = OriginalValue
        end
    end

    NoclipParts = {}
end

local function SetNoclip(State)
    NoclipEnabled = State

    if State then
        SaveNoclipParts()
    else
        RestoreNoclip()
    end
end

-- =========================================================
-- HITBOX
-- =========================================================

local function SaveHitbox(HRP)
    if HitboxOriginalValues[HRP] then
        return
    end

    HitboxOriginalValues[HRP] = {
        Size = HRP.Size,
        Transparency = HRP.Transparency,
        Material = HRP.Material,
        Color = HRP.Color,
        CanCollide = HRP.CanCollide
    }
end

local function RestoreHitbox(HRP)
    local Data = HitboxOriginalValues[HRP]

    if not Data then
        return
    end

    if HRP and HRP.Parent then
        HRP.Size = Data.Size
        HRP.Transparency = Data.Transparency
        HRP.Material = Data.Material
        HRP.Color = Data.Color
        HRP.CanCollide = Data.CanCollide
    end

    HitboxOriginalValues[HRP] = nil
end

local function RestoreAllHitboxes()
    for HRP in pairs(HitboxOriginalValues) do
        RestoreHitbox(HRP)
    end

    HitboxOriginalValues = {}
end

local function UpdateHitboxes()
    if not HitboxEnabled then
        return
    end

    for _, TargetPlayer in ipairs(Players:GetPlayers()) do
        if TargetPlayer ~= Player and TargetPlayer.Character then
            local Character = TargetPlayer.Character
            local HRP = Character:FindFirstChild("HumanoidRootPart")
            local Humanoid = GetHumanoid(Character)

            if HRP and Humanoid and Humanoid.Health > 0 then
                SaveHitbox(HRP)

                HRP.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
                HRP.Transparency = 0.7
                HRP.Color = Color3.fromRGB(255, 0, 0)
                HRP.Material = Enum.Material.Neon
                HRP.CanCollide = false
            end
        end
    end
end

-- =========================================================
-- FULLBRIGHT
-- =========================================================

local BrightVision = nil

local function Bright()
    if not FullbrightEnabled then
        return
    end

    Lighting.Brightness = 3
    Lighting.ClockTime = 14
    Lighting.FogEnd = 100000
    Lighting.GlobalShadows = false

    if not BrightVision or not BrightVision.Parent then
        BrightVision = Instance.new("ColorCorrectionEffect")
        BrightVision.Name = "XDHub_BrightVision"
        BrightVision.Parent = Lighting
    end

    BrightVision.Brightness = 0.25
    BrightVision.Contrast = 0
    BrightVision.Saturation = 0
end

local function RemoveBright()
    if BrightVision then
        if BrightVision.Parent then
            BrightVision:Destroy()
        end

        BrightVision = nil
    end
end

-- =========================================================
-- INSTANT INTERACTION
-- =========================================================

local PromptConnection = nil

local function SavePrompt(Prompt)
    if PromptOriginalValues[Prompt] then
        return
    end

    PromptOriginalValues[Prompt] = Prompt.HoldDuration
end

local function RestorePrompts()
    for Prompt, Value in pairs(PromptOriginalValues) do
        if Prompt and Prompt.Parent then
            Prompt.HoldDuration = Value
        end
    end

    PromptOriginalValues = {}
end

local function ToggleInstantInteraction(State)
    InstantInteractionEnabled = State

    if PromptConnection then
        PromptConnection:Disconnect()
        PromptConnection = nil
    end

    if not State then
        RestorePrompts()
        return
    end

    for _, Prompt in ipairs(workspace:GetDescendants()) do
        if Prompt:IsA("ProximityPrompt") then
            SavePrompt(Prompt)
            Prompt.HoldDuration = 0
        end
    end

    PromptConnection = workspace.DescendantAdded:Connect(function(Object)
        if not InstantInteractionEnabled then
            return
        end

        if Object:IsA("ProximityPrompt") then
            SavePrompt(Object)
            Object.HoldDuration = 0
        end
    end)
end

-- =========================================================
-- UNLOCK CAM
-- =========================================================

local function ToggleUnlockCam(State)
    UnlockCamEnabled = State

    if State then
        OriginalCameraMode = Player.CameraMode
        OriginalDevCamOcclusion = Player.DevCameraOcclusionMode
        if Camera then
            OriginalCameraType = Camera.CameraType
            OriginalCameraSubject = Camera.CameraSubject
        end

        Player.CameraMode = Enum.CameraMode.Classic
        Player.DevCameraOcclusionMode = Enum.DevCameraOcclusionMode.Zoom
        if Camera then
            Camera.CameraType = Enum.CameraType.Custom
            if Player.Character and Player.Character:FindFirstChild("Head") then
                Camera.CameraSubject = Player.Character.Head
            end
        end
    else
        if OriginalCameraMode ~= nil then
            Player.CameraMode = OriginalCameraMode
        end
        if OriginalDevCamOcclusion ~= nil then
            Player.DevCameraOcclusionMode = OriginalDevCamOcclusion
        end
        if Camera then
            if OriginalCameraType ~= nil then
                Camera.CameraType = OriginalCameraType
            end
            if OriginalCameraSubject ~= nil then
                Camera.CameraSubject = OriginalCameraSubject
            end
        end
    end
end

-- =========================================================
-- RENDER LOOP
-- =========================================================

RunService.RenderStepped:Connect(function(dt)
    if not Camera then
        Camera = workspace.CurrentCamera
    end

    if FovCircle and Camera then
        FovCircle.Position = Vector2.new(
            Camera.ViewportSize.X / 2,
            Camera.ViewportSize.Y / 2
        )

        FovCircle.Radius = FovRadius
    end

    if TargetLockEnabled and Camera then
        local Target = GetClosestHeadInFOV()

        if Target then
            Camera.CFrame = CFrame.new(
                Camera.CFrame.Position,
                Target.Position
            )
        end
    end

    if NoclipEnabled then
        local Character = GetCharacter()

        if Character then
            for _, Part in ipairs(Character:GetDescendants()) do
                if Part:IsA("BasePart") then
                    Part.CanCollide = false
                end
            end
        end
    end
end)

