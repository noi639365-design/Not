-- =========================================================

local function ToggleUnlockCam(State)

    if State then

        if not UnlockCamEnabled then

            OriginalCameraMode =
                Player.CameraMode

            OriginalDevCamOcclusion =
                Player.DevCameraOcclusionMode

            if Camera then

                OriginalCameraType =
                    Camera.CameraType

                OriginalCameraSubject =
                    Camera.CameraSubject

            end

        end

        UnlockCamEnabled = true

        Player.CameraMode =
            Enum.CameraMode.Classic

        Player.DevCameraOcclusionMode =
            Enum.DevCameraOcclusionMode.Zoom

        if Camera then

            Camera.CameraType =
                Enum.CameraType.Custom

            local Character =
                Player.Character

            local Head =
                Character
                and Character:FindFirstChild(
                    "Head"
                )

            if Head then

                Camera.CameraSubject =
                    Head

            end

        end

    else

        UnlockCamEnabled = false

        if OriginalCameraMode ~= nil then

            Player.CameraMode =
                OriginalCameraMode

        end

        if OriginalDevCamOcclusion ~= nil then

            Player.DevCameraOcclusionMode =
                OriginalDevCamOcclusion

        end

        if Camera then

            if OriginalCameraType ~= nil then

                Camera.CameraType =
                    OriginalCameraType

            end

            if OriginalCameraSubject ~= nil
            and OriginalCameraSubject.Parent then

                Camera.CameraSubject =
                    OriginalCameraSubject

            end

        end

        OriginalCameraMode = nil
        OriginalDevCamOcclusion = nil
        OriginalCameraType = nil
        OriginalCameraSubject = nil

    end

end


