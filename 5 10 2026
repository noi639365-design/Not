-- 18 | UNLOCK CAMERA
-- =========================================================

local function ToggleUnlockCam(State)

    if State then

        if not UnlockCamEnabled then

            OriginalCameraMode =
                Player.CameraMode

            OriginalDevCamOcclusion =
                Player.DevCameraOcclusionMode

            if Camera then

                OriginalCameraType =
                    Camera.CameraType

                OriginalCameraSubject =
                    Camera.CameraSubject
            end
        end

        UnlockCamEnabled = true

        Player.CameraMode =
            Enum.CameraMode.Classic

        Player.DevCameraOcclusionMode =
            Enum.DevCameraOcclusionMode.Zoom

        if Camera then

            Camera.CameraType =
                Enum.CameraType.Custom

            local Head =
                GetCharacter()
                and GetCharacter():FindFirstChild("Head")

            if Head then
                Camera.CameraSubject = Head
            end
        end

    else

        UnlockCamEnabled = false

        if OriginalCameraMode then
            Player.CameraMode = OriginalCameraMode
        end

        if OriginalDevCamOcclusion then
            Player.DevCameraOcclusionMode =
                OriginalDevCamOcclusion
        end

        if Camera then

            if OriginalCameraType then
                Camera.CameraType =
                    OriginalCameraType
            end

            if OriginalCameraSubject
                and OriginalCameraSubject.Parent
            then
                Camera.CameraSubject =
                    OriginalCameraSubject
            end
        end

        OriginalCameraMode = nil
        OriginalDevCamOcclusion = nil
        OriginalCameraType = nil
        OriginalCameraSubject = nil
    end
end

-- =========================================================
-- 19 | BANG
-- =========================================================

local function StopBang()

    BangEnabled = false

    if BangConnection then

        BangConnection:Disconnect()
        BangConnection = nil
    end

    if BangAnimation then

        pcall(function()
            BangAnimation:Stop()
            BangAnimation:Destroy()
        end)

        BangAnimation = nil
    end
end

local function StartBang()

    if not SelectedBangPlayer then
        return false
    end

    local Target =
        Players:FindFirstChild(SelectedBangPlayer)

    if not Target or not Target.Character then
        return false
    end

    local Char = GetCharacter()
    local Hum = GetHumanoid(Char)
    local Root = GetRoot(Char)
    local TargetRoot = GetRoot(Target.Character)

    if not Hum or not Root or not TargetRoot then
        return false
    end

    StopBang()

    local Animation =
        Instance.new("Animation")

    Animation.AnimationId =
        "rbxassetid://148840371"

    local Success, Track =
        pcall(function()
            return Hum:LoadAnimation(Animation)
        end)

    if not Success or not Track then

        Animation:Destroy()

        return false
    end

    BangAnimation = Track

    BangAnimation:Play()
    BangAnimation:AdjustSpeed(10)

    BangEnabled = true

    BangConnection =
        RunService.Heartbeat:Connect(function()

            if not BangEnabled
                or not Target.Parent
                or not Target.Character
            then
                StopBang()
                return
            end

            local CurrentRoot =
                GetRoot(GetCharacter())

            local CurrentTargetRoot =
                GetRoot(Target.Character)

            if CurrentRoot and CurrentTargetRoot then

                CurrentRoot.CFrame =
                    CurrentTargetRoot.CFrame
                    * CFrame.new(0, 0, BackDistance)
            end
        end)

    return true
end

