    else

        if Hum.UseJumpPower then

            if OriginalJumpPower ~= nil then
                Hum.JumpPower = OriginalJumpPower
            end

        else

            if OriginalJumpHeight ~= nil then
                Hum.JumpHeight = OriginalJumpHeight
            end
        end

        OriginalJumpPower = nil
        OriginalJumpHeight = nil
    end
end

