-- =========================================================

local function StopBang()

    BangEnabled = false

    if BangConnection then

        BangConnection:Disconnect()
        BangConnection = nil

    end

    if BangAnimation then

        pcall(function()

            BangAnimation:Stop()
            BangAnimation:Destroy()

        end)

        BangAnimation = nil

    end

end


local function StartBang()

    if not SelectedBangPlayer then
        return false
    end

    local TargetPlayer =
        Players:FindFirstChild(
            SelectedBangPlayer
        )

    if not TargetPlayer then
        return false
    end

    local Character =
        Player.Character

    if not Character then
        return false
    end

    local Humanoid =
        GetHumanoid(Character)

    local Root =
        GetRoot(Character)

    if not Humanoid
    or not Root then
        return false
    end

    local TargetCharacter =
        TargetPlayer.Character

    if not TargetCharacter then
        return false
    end

    local TargetRoot =
        GetRoot(TargetCharacter)

    if not TargetRoot then
        return false
    end

    if BangConnection then
        BangConnection:Disconnect()
        BangConnection = nil
    end

    if BangAnimation then

        pcall(function()
            BangAnimation:Stop()
            BangAnimation:Destroy()
        end)

        BangAnimation = nil

    end

    local Animation =
        Instance.new("Animation")

    Animation.AnimationId =
        "rbxassetid://148840371"

    local Success,Track =
        pcall(function()

            return Humanoid:LoadAnimation(
                Animation
            )

        end)

    if not Success
    or not Track then

        Animation:Destroy()
        return false

    end

    BangAnimation = Track

    BangAnimation:Play()
    BangAnimation:AdjustSpeed(10)

    BangEnabled = true

    BangConnection =
        RunService.Heartbeat:Connect(
            function()

                if not BangEnabled then
                    return
                end

                if not TargetPlayer.Parent then

                    StopBang()
                    return

                end

                local CurrentCharacter =
                    Player.Character

                local CurrentTargetCharacter =
                    TargetPlayer.Character

                if not CurrentCharacter
                or not CurrentTargetCharacter then
                    return
                end

                local CurrentRoot =
                    GetRoot(
                        CurrentCharacter
                    )

                local CurrentTargetRoot =
                    GetRoot(
                        CurrentTargetCharacter
                    )

                if CurrentRoot
                and CurrentTargetRoot then

                    CurrentRoot.CFrame =
                        CurrentTargetRoot.CFrame
                        * CFrame.new(
                            0,
                            0,
                            BackDistance
                        )

                end

            end
        )

    return true

end


