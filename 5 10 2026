-- =========================================================
-- 30 | MAIN LOOP
-- =========================================================

local AimbotTimer = 0
local NoclipTimer = 0


RunService.RenderStepped:Connect(
    function(DeltaTime)

        if not Camera then
            Camera =
                workspace.CurrentCamera
        end


        -- FOV

        if FovCircle
        and Camera then

            FovCircle.Position =
                Vector2.new(
                    Camera.ViewportSize.X / 2,
                    Camera.ViewportSize.Y / 2
                )

            FovCircle.Radius =
                FovRadius

            FovCircle.Color =
                LockColor

            FovCircle.Visible =
                ShowFovCircle

        end


        -- AIMBOT

        if TargetLockEnabled
        and Camera then

            AimbotTimer =
                AimbotTimer
                + DeltaTime

            if AimbotTimer >= 0.05 then

                AimbotTimer = 0

                if not AimbotTarget
                or not AimbotTarget.Parent
                or not IsTargetInsideFOV(
                    AimbotTarget
                )
                or not IsVisible(
                    AimbotTarget
                ) then

                    AimbotTarget =
                        GetClosestTargetInFOV()

                end

            end


            if AimbotTarget
            and AimbotTarget.Parent
            and AimbotTarget:IsDescendantOf(
                workspace
            )
            and IsTargetInsideFOV(
                AimbotTarget
            ) then

                local CameraPosition =
                    Camera.CFrame.Position

                local TargetPosition =
                    AimbotTarget.Position

                local TargetCFrame =
                    CFrame.new(
                        CameraPosition,
                        TargetPosition
                    )

                local Alpha =
                    1 /
                    math.max(
                        AimSmoothness,
                        1
                    )

                Camera.CFrame =
                    Camera.CFrame:Lerp(
                        TargetCFrame,
                        Alpha
                    )

            else

                AimbotTarget =
                    nil

            end

        else

            AimbotTimer = 0
            AimbotTarget = nil

        end


        -- NOCLIP

        if NoclipEnabled then

            NoclipTimer =
                NoclipTimer
                + DeltaTime

            if NoclipTimer >= 0.12 then

                NoclipTimer = 0

                UpdateNoclip()

            end

        else

            NoclipTimer = 0

        end

    end
)


