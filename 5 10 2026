-- =========================================================
-- 13 | AIMBOT
-- =========================================================

local AimbotRaycastParams =
    RaycastParams.new()

AimbotRaycastParams.FilterType =
    Enum.RaycastFilterType.Exclude

AimbotRaycastParams.IgnoreWater = true


local function GetTargetPart(Character)

    if not Character then
        return nil
    end

    local Part =
        Character:FindFirstChild(
            TargetPart
        )

    if Part and Part:IsA("BasePart") then
        return Part
    end

    return Character:FindFirstChild("Head")
        or Character:FindFirstChild(
            "HumanoidRootPart"
        )

end


local function IsVisible(TargetPartObject)

    if not Camera
    or not TargetPartObject then
        return false
    end

    local Character = GetCharacter()

    local Root =
        Character
        and Character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not Root then
        return false
    end

    AimbotRaycastParams.FilterDescendantsInstances = {
        Character
    }

    local Direction =
        TargetPartObject.Position
        - Camera.CFrame.Position

    local Result =
        workspace:Raycast(
            Camera.CFrame.Position,
            Direction,
            AimbotRaycastParams
        )

    if not Result then
        return true
    end

    return Result.Instance:IsDescendantOf(
        TargetPartObject.Parent
    )

end


local function IsTargetInFront(TargetPartObject)

    if not Camera
    or not TargetPartObject then
        return false
    end

    local Direction =
        (
            TargetPartObject.Position
            - Camera.CFrame.Position
        ).Unit

    local Dot =
        Camera.CFrame.LookVector:Dot(
            Direction
        )

    return Dot > 0

end


local function GetClosestTargetInFOV()

    if not Camera then
        return nil
    end

    local Character =
        GetCharacter()

    local MyHumanoid =
        GetHumanoid(Character)

    if not MyHumanoid
    or MyHumanoid.Health <= 0 then
        return nil
    end

    local ScreenCenter =
        Vector2.new(
            Camera.ViewportSize.X / 2,
            Camera.ViewportSize.Y / 2
        )

    local ClosestTarget = nil
    local ClosestDistance = FovRadius

    for _,TargetPlayer in ipairs(
        Players:GetPlayers()
    ) do

        if TargetPlayer ~= Player
        and TargetPlayer.Character then

            local TargetCharacter =
                TargetPlayer.Character

            local Humanoid =
                GetHumanoid(
                    TargetCharacter
                )

            local TargetPartObject =
                GetTargetPart(
                    TargetCharacter
                )

            if Humanoid
            and TargetPartObject
            and Humanoid.Health > 0 then

                local ScreenPosition, OnScreen =
                    Camera:WorldToViewportPoint(
                        TargetPartObject.Position
                    )

                if OnScreen
                and ScreenPosition.Z > 0
                and IsTargetInFront(
                    TargetPartObject
                ) then

                    local TargetScreenPosition =
                        Vector2.new(
                            ScreenPosition.X,
                            ScreenPosition.Y
                        )

                    local Distance =
                        (
                            TargetScreenPosition
                            - ScreenCenter
                        ).Magnitude

                    if Distance <= FovRadius
                    and Distance < ClosestDistance
                    and IsVisible(
                        TargetPartObject
                    ) then

                        ClosestDistance =
                            Distance

                        ClosestTarget =
                            TargetPartObject

                    end

                end

            end

        end

    end

    return ClosestTarget

end


local function IsTargetInsideFOV(TargetPartObject)

    if not Camera
    or not TargetPartObject
    or not TargetPartObject.Parent then

        return false
    end

    local Humanoid =
        GetHumanoid(
            TargetPartObject.Parent
        )

    if not Humanoid
    or Humanoid.Health <= 0 then
        return false
    end

    if not IsTargetInFront(
        TargetPartObject
    ) then

        return false
    end

    local ScreenPosition, OnScreen =
        Camera:WorldToViewportPoint(
            TargetPartObject.Position
        )

    if not OnScreen
    or ScreenPosition.Z <= 0 then
        return false
    end

    local Center =
        Vector2.new(
            Camera.ViewportSize.X / 2,
            Camera.ViewportSize.Y / 2
        )

    local TargetPosition =
        Vector2.new(
            ScreenPosition.X,
            ScreenPosition.Y
        )

    return (
        TargetPosition - Center
    ).Magnitude <= FovRadius

end


