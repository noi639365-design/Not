local AvatarCache = {}

local function ClearAvatarCache(UserId)
    if UserId then
        AvatarCache[UserId] = nil
    else
        AvatarCache = {}
    end
end

local function GetAvatar(PlayerObject)
    if not PlayerObject then
        return ""
    end

    local UserId = PlayerObject.UserId

    if AvatarCache[UserId] then
        return AvatarCache[UserId]
    end

    local Avatar =
        "rbxthumb://type=AvatarHeadShot&id="
        .. tostring(UserId)
        .. "&w=48&h=48"

    AvatarCache[UserId] = Avatar

    return Avatar
end

