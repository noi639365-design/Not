Player.CharacterAdded:Connect(function(Char)

    RestoreNoclip()

    AimbotTarget = nil

    task.wait(0.25)

    local Hum =
        GetHumanoid(Char)

    if not Hum then
        return
    end

    -- Save original values of new character
    OriginalWalkSpeed =
        Hum.WalkSpeed

    OriginalJumpPower =
        Hum.JumpPower

    OriginalJumpHeight =
        Hum.JumpHeight

    OriginalBreakJointsOnDeath =
        Hum.BreakJointsOnDeath

    -- Reapply movement
    if SpeedEnabled then
        ApplySpeed()
    end

    if JumpEnabled then
        ApplyJump()
    end

    if InfiniteJumpEnabled then
        ApplyInfiniteJump(Char)
    end

    -- Restore camera without overwriting
    -- the original camera values
    if UnlockCamEnabled then

        Player.CameraMode =
            Enum.CameraMode.Classic

        Player.DevCameraOcclusionMode =
            Enum.DevCameraOcclusionMode.Zoom

        if Camera then

            Camera.CameraType =
                Enum.CameraType.Custom

            local Head =
                Char:FindFirstChild("Head")

            if Head then
                Camera.CameraSubject = Head
            end
        end
    end

    -- Stay After Reset
    if ResetStayPositionEnabled
        and SavedResetPosition
    then

        task.wait(0.5)

        local Root =
            GetRoot(Char)

        if Root then
            Root.CFrame =
                SavedResetPosition
        end
    end

    -- Restart Bang
    if BangEnabled
        and SelectedBangPlayer
    then

        task.wait(1)

        StartBang()
    end
end)

