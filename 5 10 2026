-- =========================================================
-- 17 | INSTANT INTERACTION
-- =========================================================

local function SavePrompt(Prompt)

    if not Prompt then
        return
    end

    if not PromptOriginalValues[Prompt] then
        PromptOriginalValues[Prompt] = Prompt.HoldDuration
    end
end

local function RestorePrompts()

    if PromptConnection then

        PromptConnection:Disconnect()
        PromptConnection = nil
    end

    for Prompt, OriginalValue in pairs(PromptOriginalValues) do

        if Prompt and Prompt.Parent then

            pcall(function()
                Prompt.HoldDuration = OriginalValue
            end)
        end
    end

    PromptOriginalValues = {}
end

local function ToggleInstantInteraction(State)

    InstantInteractionEnabled = State

    if PromptConnection then
        PromptConnection:Disconnect()
        PromptConnection = nil
    end

    if not State then
        RestorePrompts()
        return
    end

    for _, Prompt in ipairs(workspace:GetDescendants()) do

        if Prompt:IsA("ProximityPrompt") then

            SavePrompt(Prompt)

            pcall(function()
                Prompt.HoldDuration = 0
            end)
        end
    end

    PromptConnection =
        workspace.DescendantAdded:Connect(function(obj)

            if InstantInteractionEnabled
                and obj:IsA("ProximityPrompt")
            then

                SavePrompt(obj)

                pcall(function()
                    obj.HoldDuration = 0
                end)
            end
        end)
end

