local function SavePrompt(Prompt)

    if PromptOriginalValues[Prompt] then
        return
    end

    PromptOriginalValues[Prompt] =
        Prompt.HoldDuration

end


local function RestorePrompts()

    for Prompt,Value in pairs(
        PromptOriginalValues
    ) do

        if Prompt
        and Prompt.Parent then

            pcall(function()
                Prompt.HoldDuration = Value
            end)

        end

    end

    PromptOriginalValues = {}

end


local function ToggleInstantInteraction(State)

    InstantInteractionEnabled =
        State

    if PromptConnection then

        PromptConnection:Disconnect()
        PromptConnection = nil

    end

    if not State then

        RestorePrompts()
        return

    end

    for _,Prompt in ipairs(
        workspace:GetDescendants()
    ) do

        if Prompt:IsA("ProximityPrompt") then

            SavePrompt(Prompt)

            Prompt.HoldDuration = 0

        end

    end

    PromptConnection =
        workspace.DescendantAdded:Connect(
            function(Object)

                if not InstantInteractionEnabled then
                    return
                end

                if Object:IsA("ProximityPrompt") then

                    SavePrompt(Object)

                    Object.HoldDuration = 0

                end

            end
        )

end


