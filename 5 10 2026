local function RemoveCreatedTeleportTool()

    if CreatedTeleportTool then

        pcall(function()
            CreatedTeleportTool:Destroy()
        end)

        CreatedTeleportTool = nil
    end
end

local function CreateTeleportTool()

    local Backpack =
        Player:FindFirstChildOfClass("Backpack")

    if not Backpack then
        return
    end

    if Backpack:FindFirstChild("Teleport")
        or (Player.Character and Player.Character:FindFirstChild("Teleport"))
    then

        WindUI:Notify({
            Title = "Teleport Tool",
            Content = "มีไอเท็ม Teleport อยู่แล้ว",
            Duration = 2
        })

        return
    end

    local Mouse = Player:GetMouse()

    local Tool = Instance.new("Tool")

    Tool.Name = "Teleport"
    Tool.RequiresHandle = false
    Tool.CanBeDropped = false

    Tool.Activated:Connect(function()

        if Mouse.Hit then

            local Root =
                GetRoot(GetCharacter())

            if Root then

                Root.CFrame =
                    CFrame.new(
                        Mouse.Hit.Position
                        + Vector3.new(0, 2.5, 0)
                    )
            end
        end
    end)

    Tool.Parent = Backpack

    CreatedTeleportTool = Tool

    WindUI:Notify({
        Title = "Teleport Tool",
        Content = "สร้างไอเท็ม Teleport แล้ว",
        Duration = 2
    })
end

