local ESPName = "XDHub_WhiteESP"

local function RemoveESP(Char)

    if not Char then
        return
    end

    local HL = Char:FindFirstChild(ESPName)

    if HL then
        HL:Destroy()
    end
end

local function ApplyESP(Char)

    if not ESPEnabled
        or not Char
        or not Char.Parent
    then
        return
    end

    local HL =
        Char:FindFirstChild(ESPName)
        or Instance.new("Highlight")

    HL.Name = ESPName
    HL.Parent = Char
    HL.Adornee = Char

    HL.FillTransparency = 0.5
    HL.OutlineTransparency = 0
    HL.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

    HL.FillColor = ESPColor
    HL.OutlineColor = ESPColor
end

local function SetupESPPlayer(tp)

    if tp == Player then
        return
    end

    tp.CharacterAdded:Connect(function(Char)

        task.wait(0.5)

        if ESPEnabled then
            ApplyESP(Char)
        end
    end)

    if tp.Character and ESPEnabled then
        ApplyESP(tp.Character)
    end
end

local function ToggleAllESP(State)

    ESPEnabled = State

    for _, tp in ipairs(Players:GetPlayers()) do

        if tp ~= Player and tp.Character then

            if State then
                ApplyESP(tp.Character)
            else
                RemoveESP(tp.Character)
            end
        end
    end
end

for _, tp in ipairs(Players:GetPlayers()) do
    SetupESPPlayer(tp)
end

