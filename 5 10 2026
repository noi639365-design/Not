local function SaveNoclipParts()

    NoclipParts = {}

    local Character =
        GetCharacter()

    if not Character then
        return
    end

    for _,Object in ipairs(
        Character:GetDescendants()
    ) do

        if Object:IsA("BasePart") then

            NoclipParts[Object] =
                Object.CanCollide

        end

    end

end


local function RestoreNoclip()

    for Part,OriginalValue in pairs(
        NoclipParts
    ) do

        if Part
        and Part.Parent then

            Part.CanCollide =
                OriginalValue

        end

    end

    NoclipParts = {}

end


local function SetNoclip(State)

    NoclipEnabled = State

    if State then
        SaveNoclipParts()
    else
        RestoreNoclip()
    end

end


local function UpdateNoclip()

    if not NoclipEnabled then
        return
    end

    local Character =
        GetCharacter()

    if not Character then
        return
    end

    for _,Object in ipairs(
        Character:GetDescendants()
    ) do

        if Object:IsA("BasePart") then

            if NoclipParts[Object] == nil then
                NoclipParts[Object] =
                    Object.CanCollide
            end

            Object.CanCollide = false

        end

    end

end


