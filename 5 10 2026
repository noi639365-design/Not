local function RemoveCreatedTeleportTool()

    if CreatedTeleportTool then

        pcall(function()

            if CreatedTeleportTool.Parent then
                CreatedTeleportTool:Destroy()
            end

        end)

        CreatedTeleportTool = nil

    end

end


local function CreateTeleportTool()

    local Backpack =
        Player:FindFirstChildOfClass(
            "Backpack"
        )

    if not Backpack then
        return nil
    end

    local Existing =
        Backpack:FindFirstChild(
            "Teleport"
        )

    if Existing
    and Existing:IsA("Tool") then

        CreatedTeleportTool =
            Existing

        WindUI:Notify({

            Title = "Teleport Tool",
            Content =
                "มีไอเท็ม Teleport อยู่แล้ว",
            Duration = 2

        })

        return Existing

    end

    local Mouse =
        Player:GetMouse()

    local Tool =
        Instance.new("Tool")

    Tool.Name =
        "Teleport"

    Tool.RequiresHandle =
        false

    Tool.CanBeDropped =
        false

    Tool.Activated:Connect(
        function()

            if not Mouse.Hit then
                return
            end

            local Character =
                Player.Character

            if not Character then
                return
            end

            local Root =
                GetRoot(Character)

            if not Root then
                return
            end

            Root.CFrame =
                CFrame.new(
                    Mouse.Hit.Position
                    + Vector3.new(
                        0,
                        2.5,
                        0
                    )
                )

        end
    )

    Tool.Parent =
        Backpack

    CreatedTeleportTool =
        Tool

    WindUI:Notify({

        Title = "Teleport Tool",
        Content =
            "สร้างไอเท็ม Teleport แล้ว",
        Duration = 2

    })

    return Tool

end


