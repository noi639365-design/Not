-- 30 | MAIN RENDER LOOP
-- =========================================================

RunService.RenderStepped:Connect(function()

    if not Camera then
        Camera = workspace.CurrentCamera
    end

    -- FOV
    if FovCircle and Camera then

        FovCircle.Position =
            Vector2.new(
                Camera.ViewportSize.X / 2,
                Camera.ViewportSize.Y / 2
            )

        FovCircle.Radius = FovRadius
        FovCircle.Color = LockColor
        FovCircle.Visible = ShowFovCircle
    end

    -- AIMBOT
    if TargetLockEnabled and Camera then

        if not AimbotTarget
            or not AimbotTarget.Parent
            or not IsTargetInsideFOV(AimbotTarget)
            or not IsVisible(AimbotTarget)
        then

            AimbotTarget =
                GetClosestTargetInFOV()
        end

        if AimbotTarget
            and AimbotTarget.Parent
            and IsTargetInsideFOV(AimbotTarget)
        then

            local LookCFrame =
                CFrame.new(
                    Camera.CFrame.Position,
                    AimbotTarget.Position
                )

            Camera.CFrame =
                Camera.CFrame:Lerp(
                    LookCFrame,
                    1 / math.max(
                        AimSmoothness,
                        1
                    )
                )

        else

            AimbotTarget = nil
        end

    else

        AimbotTarget = nil
    end

    -- NOCLIP
    if NoclipEnabled then

        local Char = GetCharacter()

        if Char then

            for _, Obj in ipairs(Char:GetDescendants()) do

                if Obj:IsA("BasePart") then
                    Obj.CanCollide = false
                end
            end
        end
    end
end)

