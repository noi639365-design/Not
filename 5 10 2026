-- =========================================================
-- 35 | CHARACTER RESPAWN
-- =========================================================

Player.CharacterAdded:Connect(
    function(Character)

        RestoreNoclip()

        AimbotTarget =
            nil

        if HitboxEnabled then
            task.defer(
                UpdateHitboxes
            )
        end

        task.wait(0.25)

        local Humanoid =
            Character:WaitForChild(
                "Humanoid",
                10
            )

        if not Humanoid then
            return
        end


        -- เก็บค่าเดิมของตัวละครใหม่
        OriginalWalkSpeed =
            Humanoid.WalkSpeed

        OriginalJumpPower =
            Humanoid.JumpPower

        OriginalJumpHeight =
            Humanoid.JumpHeight

        OriginalBreakJointsOnDeath =
            Humanoid.BreakJointsOnDeath


        -- SPEED
        if SpeedEnabled then
            ApplySpeed()
        end


        -- JUMP
        if JumpEnabled then
            ApplyJump()
        end


        -- INFINITE JUMP
        if InfiniteJumpEnabled then
            ApplyInfiniteJump(
                Character
            )
        end


        -- NOCLIP
        if NoclipEnabled then
            SaveNoclipParts()
        end


        -- ESP ไม่ต้องทำกับ LocalPlayer


        -- CAMERA
        if UnlockCamEnabled then

            task.wait(0.1)

            -- ไม่เรียก ToggleUnlockCam(true)
            -- เพราะจะเขียนค่ากล้องเดิมทับ

            Player.CameraMode =
                Enum.CameraMode.Classic

            Player.DevCameraOcclusionMode =
                Enum.DevCameraOcclusionMode.Zoom

            if Camera then

                Camera.CameraType =
                    Enum.CameraType.Custom

                local Head =
                    Character:FindFirstChild(
                        "Head"
                    )

                if Head then

                    Camera.CameraSubject =
                        Head

                end

            end

        end


        -- BANG
        if BangEnabled
        and SelectedBangPlayer then

            task.wait(1)

            StopBang()

            if SelectedBangPlayer then

                StartBang()

            end

        end


        -- STAY AFTER RESET
        if ResetStayPositionEnabled
        and SavedResetPosition then

            ReturnToResetPosition(
                Character
            )

        end

    end
)


